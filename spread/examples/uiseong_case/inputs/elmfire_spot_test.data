/




&SPOTTING
ENABLE_SPOTTING = .TRUE.
ENABLE_SURFACE_FIRE_SPOTTING = .TRUE.
USE_SUPERSEDED_SPOTTING = .FALSE.
GENERATION_MODEL = 'RANDOM'
SPOTTING_DISTANCE_MODEL = 'UNIFORM'
ACCUMULATION_MODEL = 'LAGRANGIAN'
