WEATHER_DIRECTORY              = './inputs'
WS_FILENAME = 'ws_hourly'
WD_FILENAME = 'wd_hourly'
M1_FILENAME = 'm1_hourly'
M10_FILENAME = 'm10_hourly'
M100_FILENAME = 'm100_hourly'
