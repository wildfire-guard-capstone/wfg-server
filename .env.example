# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://wfg:wfg@localhost:5432/wfg

# Local root of the AI Hub "산불 확산 위험 대응방안 추론 데이터" (…/3.개방데이터/1.데이터)
AIHUB_ROOT=
# Local working directory for rasters, runs and results
DATA_ROOT=./data

# ELMFIRE executable inside the worker image (elmfire_$ELMFIRE_VER)
ELMFIRE_BIN=elmfire_1.1

# Korea Meteorological Administration API hub key
KMA_API_KEY=
