/

&OUTPUTS
OUTPUTS_DIRECTORY = './outputs_spot_test'
DTDUMP               = 3600.
DUMP_FLIN            = .TRUE.
DUMP_SPREAD_RATE     = .TRUE.
DUMP_TIME_OF_ARRIVAL = .TRUE.
