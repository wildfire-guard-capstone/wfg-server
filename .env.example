# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://wfg:wfg@localhost:5432/wfg

# Local root of the AI Hub "산불 확산 위험 대응방안 추론 데이터" (…/3.개방데이터/1.데이터)
AIHUB_ROOT=
# Local working directory for rasters, runs and results
DATA_ROOT=./data
# Base data load files (capston-data …/data/지도자원/적재) for `python -m app.db.seed.base`
BASE_DATA_DIR=

# ELMFIRE executable inside the worker image (elmfire_$ELMFIRE_VER)
ELMFIRE_BIN=elmfire_1.1

# Korea Meteorological Administration API hub key
KMA_API_KEY=

# 결과 조회 API — `python -m demo.uiseong.export_bundle`이 만든 묶음 폴더(저장소 밖, 공개 금지)
RESULTS_DIR=
# 로그인 — 계정 파일(`python -m app.services.accounts add …`)과 토큰 서명 키(32자 이상, 무작위)
ACCOUNTS_FILE=
AUTH_SECRET=
TOKEN_TTL_MINUTES=480
# 다른 출처에서 부를 때만(JSON 목록), 예: ["http://127.0.0.1:5173"]. 같은 출처 배포면 비워 둔다
CORS_ORIGINS=[]
