# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://wfg:wfg@localhost:5432/wfg

# Local root of the AI Hub "산불 확산 위험 대응방안 추론 데이터" (…/3.개방데이터/1.데이터)
AIHUB_ROOT=
# Local working directory for rasters, runs and results
DATA_ROOT=./data
# Base data load files (capston-data …/data/지도자원/적재) for `python -m app.db.seed.base`
BASE_DATA_DIR=

# ELMFIRE executable inside the worker image (elmfire_$ELMFIRE_VER)
ELMFIRE_BIN=elmfire_1.1
# 예측 제공자(PRED-01): synthetic(기본) · file · elmfire. elmfire면 덱 폴더가 필요하다
# (demo/uiseong/deck 모양, GPU 서버). 실행 폴더는 PREDICTOR_WORK_DIR(없으면 덱 옆 runs/)
# PREDICTOR=elmfire
# PREDICTOR_DECK=/path/to/wfg/demo/deck
# PREDICTOR_WORK_DIR=
# elmfire 기상 출처: stations(실시간, 기본 — 관측소 매분자료 + 단기예보, KMA_API_KEY ·
# DATA_GO_KR_API_KEY 필요) · deck(시연 — 덱에 든 의성 관측 기상, WEATHER=asos와 같이 쓴다).
# 못 받으면 예측 요청이 503 WEATHER_UNAVAILABLE. docs/ELMFIRE-기상.md
# PREDICTOR_WEATHER_FIELD=stations

# Korea Meteorological Administration API hub key
KMA_API_KEY=
# 공공데이터포털(기상청 단기예보, WEATHER=kma · PREDICTOR_WEATHER_FIELD=stations)
DATA_GO_KR_API_KEY=

# 제안 작성기(PRED-01 · PROP-05): fake(기본, 테스트 문장) · agent(EXAONE + 근거 검색).
# agent · ASSISTANT=exaone은 GPU 서버의 vLLM · 근거 서버 주소가 필요하다(deploy/README.md 「GPU 서버 연결」)
# PROPOSAL_WRITER=agent
# ASSISTANT=exaone
# LLM_URL=http://127.0.0.1:8031
# EVIDENCE_URL=http://127.0.0.1:8032

# ── 김지오 전용 · 임시 결과 조회 API(app/demo_results) — 그 폴더를 지울 때 이 네 줄도 지운다
# 결과 묶음 폴더(`python -m demo.uiseong.export_bundle`이 만듦, 저장소 밖, 공개 금지)
RESULTS_DIR=
# 로그인 — 계정 파일(`python -m app.demo_results.accounts add …`)과 토큰 서명 키(32자 이상, 무작위)
ACCOUNTS_FILE=
AUTH_SECRET=
TOKEN_TTL_MINUTES=480
# ── (임시 끝)
# 다른 출처에서 부를 때만(JSON 목록), 예: ["http://127.0.0.1:5173"]. 같은 출처 배포면 비워 둔다
CORS_ORIGINS=[]
